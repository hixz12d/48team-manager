APP_NAME="48 Team Manager"
APP_HOST="0.0.0.0"
APP_PORT=8008
DEBUG=True

# New schema. Never point this at a production team_manage.db.
DATABASE_URL="sqlite+aiosqlite:///./data/team48.db"

SECRET_KEY="your-secret-key-here-change-in-production"
ADMIN_USERNAME="hixz12"
ADMIN_PASSWORD="change-this-before-deploy"
# Personal signup extension handoff (/api/ext). Empty disables it. Use 32+ random chars:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
EXTENSION_API_TOKEN=

LOG_LEVEL="INFO"
DATABASE_ECHO=False
TIMEZONE=Asia/Shanghai

BROWSER_HEADLESS=False
BROWSER_CHANNEL=chrome
# Applies to registration AND standalone OAuth/reauth; path inside the runtime.
BROWSER_EXECUTABLE=
# Set chromix with a verified Chromix executable to enable persistent per-account seeds.
BROWSER_ENGINE=chromium
# Opt in to the shared extension signup runner; legacy remains the default.
BROWSER_SIGNUP_FLOW=legacy
# Chromix saves these when creating an account profile; existing profiles retain them.
BROWSER_LOCALE=en-US
# IANA timezone. Empty: Chromium uses host timezone; new Chromix profiles pin UTC.
BROWSER_TIMEZONE=

# Rotation signup/OAuth runner: playwright (legacy, default) or extension
# (Chromix subprocess + the real signup extension; no Playwright/CDP).
# Only manual and automatic rotation use it; switch back to playwright any time.
ROTATION_SIGNUP_RUNNER=playwright
# Chromix 153 launcher; required when ROTATION_SIGNUP_RUNNER=extension.
# On Linux use the bundled "chromix" launcher (it loads the bundled fonts).
RUNNER_BROWSER_EXECUTABLE=
# Persona for NEW runner profiles only (existing profiles keep theirs): linux / windows.
RUNNER_FINGERPRINT_PLATFORM=linux
# native: real WebGL identity; preset: show a common GPU string for the platform
# (compatibility backend). Only affects NEW runner profiles.
RUNNER_GPU_MODE=native
# Extension source directory (relative to the project root or absolute).
RUNNER_EXTENSION_DIR=extensions/chatgpt-signup
# Address the extension uses to reach this server (loopback, never via proxy).
RUNNER_LOCAL_BASE_URL=http://127.0.0.1:8008
# Upper bound for one runner run, seconds.
RUNNER_TIMEOUT_SECONDS=1500

IDENTITY_GMAIL_POLICY=owner_only
OFFICIAL_QUOTA_PROBE_ENABLED=False
AUTO_REAUTH_ENABLED=False
AUTO_ROTATE_ENABLED=False
FORCE_REFILL=False
